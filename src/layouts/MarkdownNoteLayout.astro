---
import type { CollectionEntry } from 'astro:content';
import PageBaseLayout from './PageBaseLayout.astro';
import PageTitleHeader from '$components/PageTitleHeader.astro';
import '$assets/styles/style.css';
import '$assets/styles/article.css';
import '$assets/styles/shiki.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

type Props = {
	frontmatter: CollectionEntry<'notes'>['data'];
};

const { frontmatter: fm } = Astro.props;
const { title, description, date } = fm;
const canonical = new URL(Astro.url.pathname, Astro.site);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en', { dateStyle: 'medium' });
---

<PageBaseLayout
	title=`${title} | Sid Vishnoi`
	meta={{ canonical, description }}
>
	<Fragment slot="head">
		<meta property="og:type" content="article" />
		<meta property="article:author" content="https://sidvishnoi.com/about/" />
		<meta property="article:published_time" content={date.toISOString()} />
		{
			fm.modified && (
				<meta
					property="article:modified_time"
					content={fm.modified.toISOString()}
				/>
			)
		}
	</Fragment>

	<article id="main" class="h-entry">
		<PageTitleHeader>
			<a
				href={Astro.url.pathname}
				class="p-name u-url"
				set:html={mdBackticksToHTML(title)}
				slot="title"
			/>

			<p>
				Published <time class="dt-published" datetime={date.toISOString()}
					>{formatDate(date)}</time
				>
				{
					fm.modified && (
						<Fragment>
							and last updated{' '}
							<time class="dt-updated" datetime={fm.modified.toISOString()}>
								{formatDate(fm.modified)}
							</time>
						</Fragment>
					)
				}
			</p>
		</PageTitleHeader>

		<div class="e-content">
			<slot />
		</div>

		<footer>
			<div class="tags">
				Tags:
				<ul aria-label="Tags">
					{
						fm.tags.map((tag) => (
							<li>
								<a href={`../tags/${tag}/`}>#{tag}</a>
							</li>
						))
					}
				</ul>
			</div>
		</footer>
	</article>
</PageBaseLayout>

<style>
	.tags {
		font-size: smaller;
	}
	.tags ul {
		margin: 0;
		padding: 0;
		display: inline-flex;
		list-style: none;
		flex-wrap: wrap;
		gap: 0.25em;
	}
</style>
