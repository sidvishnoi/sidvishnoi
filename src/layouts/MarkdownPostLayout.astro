---
import PageBaseLayout from './PageBaseLayout.astro';
import PageTitleHeader from '$components/PageTitleHeader.astro';
import { mdBackticksToHTML, withParams } from '$lib/utils.ts';
import '$assets/styles/style.css';
import '$assets/styles/article.css';
import '$assets/styles/shiki.css';
import type { CollectionEntry } from 'astro:content';

type Props = {
	frontmatter: CollectionEntry<'articles'>['data'];
};

const { frontmatter: fm } = Astro.props;
const { title, heading, description } = fm;
const shareImage = fm.image?.url ? new URL(fm.image?.url) : undefined;
const canonical = new URL(fm.canonical || Astro.url.pathname, Astro.site);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en', { dateStyle: 'medium' });
---

<PageBaseLayout
	title=`${title} | Sid Vishnoi`
	meta={{ canonical, description, shareImage }}
>
	<Fragment slot="head">
		<meta property="og:type" content="article" />
		<meta property="article:author" content="https://sidvishnoi.com/about/" />
		<meta property="article:published_time" content={fm.date.toISOString()} />
		{
			fm.modified && (
				<meta
					property="article:modified_time"
					content={fm.modified.toISOString()}
				/>
			)
		}
	</Fragment>

	<article id="main" class="h-entry">
		<PageTitleHeader>
			<a
				href={Astro.url.pathname}
				class="p-name u-url"
				set:html={mdBackticksToHTML(heading)}
				slot="title"
			/>

			<p>
				Published <time class="dt-published" datetime={fm.date.toISOString()}
					>{formatDate(fm.date)}</time
				>
				{
					fm.modified && (
						<Fragment>
							and last updated{' '}
							<time class="dt-updated" datetime={fm.modified.toISOString()}>
								{formatDate(fm.modified)}
							</time>
						</Fragment>
					)
				}
				{
					fm.canonical && (
						<Fragment>
							∙ Originally published on{' '}
							<a
								href={withParams(fm.canonical, { ref: 'sidvishnoi.com' }).href}
								target="_blank"
								rel="nofollow"
							>
								{canonical.hostname.replace(/^www\./, '')}
							</a>
						</Fragment>
					)
				}
			</p>
		</PageTitleHeader>

		<div class="e-content">
			<slot />
		</div>
	</article>
</PageBaseLayout>
