---
import { getCollection } from 'astro:content';

import PageBaseLayout from '$layouts/PageBaseLayout.astro';
import PageTitleHeader from '$components/PageTitleHeader.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

const allPosts = await Promise.all([
	getCollection('articles'),
	getCollection('notes'),
]);
const articles = allPosts
	.flat()
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 10);
---

<PageBaseLayout title="Sid Vishnoi's articles & notes">
	<PageTitleHeader title="Articles & Notes" />

	<div id="main" class="items">
		<ul>
			{
				articles.map((entry) => (
					<li class:list={['item', entry.collection]}>
						<article>
							<h3>
								<a
									href={
										entry.collection === 'articles'
											? `/articles/${entry.id}/`
											: `/notes/${entry.id}/`
									}
									set:html={mdBackticksToHTML(entry.data.title)}
								/>
							</h3>

							<p>{entry.data.description}</p>

							<div class="meta">
								<p>
									<span class="sr-only">Published </span>
									<time datetime={entry.data.date.toISOString()}>
										{entry.data.date.toLocaleDateString('en', {
											dateStyle: 'medium',
										})}
									</time>
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>

	<div class="view-all">
		<span>View all:</span>
		<a
			href="/articles/"
			class="button"
			style="--bg-color: var(--color-b); --bg-color-alt: var(--color-b-alt);"
			>articles</a
		>
		<a
			href="/notes/"
			class="button"
			style="--bg-color: var(--color-a); --bg-color-alt: var(--color-a-alt);"
			>notes</a
		>
	</div>
</PageBaseLayout>

<style>
	.view-all {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1em;
		text-align: center;
		font-weight: bold;
		margin: 1em auto;
	}
</style>
