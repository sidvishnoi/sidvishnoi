---
import { getCollection } from 'astro:content';

import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/NavHeader.astro';
import PageTitle from '$components/PageTitle.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

const allPosts = await Promise.all([
	getCollection('articles'),
	getCollection('notes'),
]);
const articles = allPosts
	.flat()
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 10);
---

<HomeLayout title="Sid Vishnoi's articles & notes">
	<Header />
	<PageTitle>Articles & Notes</PageTitle>

	<div id="main" class="items">
		<ul>
			{
				articles.map((entry) => (
					<li class:list={[entry.collection]}>
						<article>
							<h3>
								<a
									href={
										entry.collection === 'articles'
											? `/articles/${entry.id}/`
											: `/notes/${entry.id}/`
									}
									set:html={mdBackticksToHTML(entry.data.title)}
								/>
							</h3>

							<p>{entry.data.description}</p>

							<div class="meta">
								<p>
									<span class="sr-only">Published </span>
									<time datetime={entry.data.date.toISOString()}>
										{entry.data.date.toLocaleDateString('en', {
											dateStyle: 'medium',
										})}
									</time>
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>

	<div class="view-all">
		<span>View all:</span>
		<a
			href="/articles/"
			class="button"
			style="--bg-color: var(--color-b); --bg-color-alt: var(--color-b-alt);"
			>articles</a
		>
		<a
			href="/notes/"
			class="button"
			style="--bg-color: var(--color-a); --bg-color-alt: var(--color-a-alt);"
			>notes</a
		>
	</div>
</HomeLayout>

<style is:global>
	.items ul {
		list-style: none;
		margin: 0;
		margin: 0 auto;
		max-width: 80ch;
	}

	.items li {
		padding: 1em;
		margin: 0;
		position: relative;
	}

	.items li + li {
		margin-top: 0.5em;
	}

	.items li a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.items .meta p {
		font-size: smaller;
		margin-left: 0;
		max-width: 100%;
		color: var(--color-alt);
	}

	.items li::before {
		position: absolute;
		left: 3.5em;
		top: 0em;
		content: ' ';
		display: block;
		border-radius: 0.1rem;
		font-size: 0.4em;
		padding: 0.2rem;
	}

	.items li.notes::before {
		content: 'NOTE';
		background-color: var(--color-a);
		color: #111;
	}

	.items li.articles::before {
		content: 'ARTICLE';
		background-color: var(--color-b);
		color: #fff;
	}

	.view-all {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1em;
		text-align: center;
		font-weight: bold;
		margin: 1em auto;
	}

	@media (max-width: 640px) {
		.items li {
			text-align: left;
			padding: 1em 0;
		}
		.items li::before {
			left: 1.5em;
		}
		.items li:last-of-type {
			padding-bottom: 1em;
		}
	}
</style>
