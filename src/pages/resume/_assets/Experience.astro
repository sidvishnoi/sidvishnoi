---
import { ExperienceItem } from './resume';
---

<section class="experience">
	<h2>Work Experience</h2>

	<ExperienceItem
		title="Interledger Foundation - Full-Stack Developer"
		duration={['May 2024', 'Present']}
		time="124w"
	>
		<li>
			Own the Web Monetization browser extension, the reference implementation
		</li>
		<li>Develop algorithms for cross-currency micropayments</li>
		<li>
			Collaborate with engineers at Igalia to bring native support to Chromium
		</li>
		<li>
			Build embeddable publisher tools and payment systems that use Open
			Payments
		</li>
		<li>Drive direction for Open Payments with new features and use-cases</li>
		<li>
			Write technical articles about Web Monetization and act as an editor for
			the WICG specification
		</li>
	</ExperienceItem>

	<ExperienceItem
		title="Monetized - Founding Engineer"
		duration={['Aug 2021', 'May 2024']}
		time="148w"
	>
		<li>
			Built <a href="https://www.monetized.link">monetized.link</a> / <a
				href="https://www.keyosk.co">keyosk.co</a
			>, a multi-tenant no-code paywall platform for publishers, end-to-end
		</li>
		<li>
			Developed editor & dashboard interfaces in SvelteKit, with Firebase,
			Redis, ElasticSearch on the backend
		</li>
		<li>
			Implemented payments infrastructure: Stripe purchases and creator payouts,
			plus Web3 support
		</li>
		<li>Managed GCP deployments with a microservices architecture</li>
	</ExperienceItem>

	<ExperienceItem
		title="Grant for the Web - Technical Scholar"
		duration={['Aug 2020', 'Apr 2021']}
		time="34w"
	>
		<li>
			Built a native Web Monetization prototype in Firefox, shaping the WICG
			spec
		</li>
		<li>
			Picked up Gecko's C++ codebase to work across the core browser engine and
			the extensions API
		</li>
	</ExperienceItem>

	<ExperienceItem
		title="Mozilla Open Source Support (MOSS) Program"
		duration={['May 2020', 'Jul 2020']}
		time="13w"
	>
		<li>
			Core maintainer of ReSpec, the publication system used to author W3C
			standards
		</li>
		<li>
			Shipped new features, overhauled the project's documentation, and
			contributed to specifications across multiple W3C working groups
		</li>
	</ExperienceItem>

	<ExperienceItem
		title="Chegg - Software Development Engineer Intern"
		duration={['Jan 2019', 'Jul 2019']}
		time="26w"
	>
		<li>UI engineer for Chegg Prep (React, TypeScript, CSS-in-JS, Node.js)</li>
		<li>Improved CheggIndia.com's performance (from 4s load to 200ms)</li>
		<li>
			Built internal tools spanning UI design, ticket automation, and LDAP and
			internal API integrations
		</li>
	</ExperienceItem>

	<ExperienceItem
		title="Mozilla - Google Summer of Code"
		duration={['May 2018', 'Aug 2018']}
		time="16w"
	>
		<li>
			Developed new features in ReSpec, focused on UX, automation, and
			maintainability
		</li>
	</ExperienceItem>
</section>
