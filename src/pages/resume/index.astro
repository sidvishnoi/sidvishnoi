---
import BaseLayout from '$layouts/BaseLayout.astro';
import '$assets/styles/resume.css';
import '@fontsource/source-sans-pro/latin-400.css';
import '@fontsource/source-sans-pro/latin-700.css';

import Experience from './_assets/Experience.astro';
import Skills from './_assets/Skills.astro';
import { Header, Education } from './_assets/resume';
import { IconPdf } from './_assets/icons';

const META_DESCRIPTION: string = `Full-stack engineer, 7+ years shipping accessible, performant software in JavaScript/TypeScript, with experience in C++, Python, and Rust.`;
---

<BaseLayout
	title="Sid Vishnoi - Resume"
	meta={{
		description: META_DESCRIPTION,
		shareImage: new URL('/og-default.png', Astro.request.url),
	}}
>
	<Header title="Senior Full-Stack Engineer">
		Product-focused engineer, 7+ years shipping software; remote and async.
		Leading Web Monetization at Interledger Foundation. Focused on
		accessibility, UX, and performance. Shipping faster with AI, carefully.
	</Header>

	<a
		rel="alternate"
		type="application/pdf"
		href="/resume/sid-vishnoi-resume.pdf"
		class="with-icon noprint"
		title="Download Resume as PDF"
	>
		<IconPdf />
		PDF version
	</a>

	<main>
		<Experience />
		<Education />
		<Skills />
		<!-- <References /> -->
	</main>
</BaseLayout>
