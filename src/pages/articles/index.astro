---
import { getCollection } from 'astro:content';

import PageBaseLayout from '$layouts/PageBaseLayout.astro';
import PageTitleHeader from '$components/PageTitleHeader.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

const articles = (await getCollection('articles')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<PageBaseLayout title="Sid Vishnoi's articles">
	<PageTitleHeader title="Articles" />

	<div id="main" class="items">
		<ul>
			{
				articles.map((entry) => (
					<li class="item">
						<article>
							<h3>
								<a
									href={`/articles/${entry.id}/`}
									set:html={mdBackticksToHTML(entry.data.title)}
								/>
							</h3>

							<p>{entry.data.description}</p>

							<div class="meta">
								<p>
									<span class="sr-only">Published </span>
									<time datetime={entry.data.date.toISOString()}>
										{entry.data.date.toLocaleDateString('en', {
											dateStyle: 'medium',
										})}
									</time>
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</PageBaseLayout>
