---
import { getCollection } from 'astro:content';

import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/NavHeader.astro';
import PageTitle from '$components/PageTitle.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

const articles = (await getCollection('articles')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<HomeLayout title="Sid Vishnoi's articles">
	<Header />
	<PageTitle>Articles</PageTitle>

	<div id="main" class="items">
		<ul>
			{
				articles.map((entry) => (
					<li class="item">
						<article>
							<h3>
								<a
									href={`/articles/${entry.id}/`}
									set:html={mdBackticksToHTML(entry.data.title)}
								/>
							</h3>

							<p>{entry.data.description}</p>

							<div class="meta">
								<p>
									<span class="sr-only">Published </span>
									<time datetime={entry.data.date.toISOString()}>
										{entry.data.date.toLocaleDateString('en', {
											dateStyle: 'medium',
										})}
									</time>
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</HomeLayout>
