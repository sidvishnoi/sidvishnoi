---
import HomeLayout from '$layouts/HomeLayout.astro';
import LogoLarge from '$components/LogoLarge.astro';
---

<HomeLayout
	title="Sid Vishnoi"
	meta={{
		description: `Software engineer and full-stack web developer with a knack for front-end development`,
	}}
>
	<Fragment slot="head">
		<meta property="og:type" content="website" />
	</Fragment>

	<header class="header">
		<LogoLarge />
		<p class="subtitle">I like web development and building software.</p>

		<nav class:list={['primary']}>
			<a href="/about/" class="button">About</a>
			<a href="/writing/" class="button">Writing</a>
			<a href="/resume/" class="button">Resume</a>
		</nav>
	</header>
</HomeLayout>

<style>
	:global(main *) {
		margin: 0;
		padding: 0;
	}

	.header {
		text-align: center;
		line-height: 1.2;
		padding: 8vmin 1vmin;
		max-width: 0 auto;
	}

	.subtitle {
		font-size: clamp(1.2rem, 0.815rem + 2.407vw, 2.5rem);
		font-weight: normal;
		margin: 0;
	}
</style>
