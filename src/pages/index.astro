---
import HomeLayout from '$layouts/HomeLayout.astro';
import LogoLarge from '$components/LogoLarge.astro';
import HeaderLinks from '$components/HeaderLinks.astro';
---

<HomeLayout
	title="Sid Vishnoi"
	meta={{
		description: `Full-stack engineer, focused on accessibility, UX, and performance, with 7+ years experience.`,
	}}
>
	<Fragment slot="head">
		<meta property="og:type" content="website" />
	</Fragment>

	<header class="header">
		<LogoLarge />
	</header>
	<p class="summary">
		Product engineer. 7+ years shipping software.<br />
		Focused on accessibility, UX, and performance.<br />
		Leading Web Monetization at Interledger Foundation.
	</p>
	<HeaderLinks />
</HomeLayout>

<style>
	:global(body) {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	:global(main) {
		flex: 1;
	}

	.header {
		text-align: center;
		line-height: 1.2;
		padding: 10vmin 1.5rem 0;
	}

	.summary {
		font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.4rem);
		font-weight: normal;
		line-height: 1.5;
		color: var(--color-alt);
		text-align: center;
		max-width: 38rem;
		margin: 1.75rem auto 0;
		padding: 0 1.5rem;
	}
</style>
