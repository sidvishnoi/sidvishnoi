---
import { getCollection } from 'astro:content';

import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/NavHeader.astro';
import PageTitle from '$components/PageTitle.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

const baseNotes = await getCollection('notes');
const notes = baseNotes
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 10);
---

<HomeLayout title="Sid Vishnoi's notes">
	<Header />
	<PageTitle>Notes</PageTitle>

	<div id="main" class="items">
		<ul>
			{
				notes.map((note) => (
					<li>
						<article>
							<h3>
								<a
									href={`/notes/${note.id}/`}
									set:html={mdBackticksToHTML(note.data.heading)}
								/>
							</h3>

							<p>{note.data.description}</p>

							<div class="meta">
								<p>
									<span class="sr-only">Published </span>
									<time datetime={note.data.date.toISOString()}>
										{note.data.date.toLocaleDateString('en', {
											dateStyle: 'medium',
										})}
									</time>
								</p>
								<div>
									<span class="sr-only">Tagged under: </span>
									<ul class="tags">
										{note.data.tags.map((tag) => (
											<li>
												<a href={`./tags/${tag}/`}>#{tag}</a>
											</li>
										))}
									</ul>
								</div>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</HomeLayout>

<style is:global>
	.items ul {
		list-style: none;
		margin: 0;
	}

	.items > ul > li {
		padding: 1em;
		max-width: 80ch;
		margin: 0 auto;
		position: relative;
	}

	.items > ul > li + li {
		margin-top: 0.5em;
	}

	.items .meta > * {
		display: inline-block;
	}

	.items .meta p {
		font-size: smaller;
		margin-left: 0;
		width: auto;
		color: var(--color-alt);
	}

	.items .meta .tags {
		margin: 0;
		padding: 0;
		display: inline;
		list-style: none;
		font-size: smaller;
	}
	.items .meta .tags li {
		display: inline;
	}
	.items .meta .tags a {
		color: var(--color-alt);
		text-decoration: none;
		font-style: italic;
	}

	@media (max-width: 640px) {
		.items > ul > li {
			text-align: left;
			padding: 1em 0;
		}
		.items > ul > li:last-of-type {
			padding-bottom: 1em;
		}
	}
</style>
