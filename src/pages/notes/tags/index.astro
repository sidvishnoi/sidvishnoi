---
import { getCollection } from 'astro:content';

import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/PageHeader.astro';
import Heading from '$components/Heading.astro';

const notes = await getCollection('notes');
const allTags = notes.flatMap((e) => e.data.tags);
const tagCounts = allTags.reduce(
	(acc, tag) => {
		acc[tag] = (acc[tag] || 0) + 1;
		return acc;
	},
	Object.create(null) as Record<string, number>,
);
const tags = Object.keys(tagCounts).sort();
---

<HomeLayout title="All topics for Sid's Notes">
	<Header />
	<Heading tag="h2">Notes / Tags</Heading>

	<div class="tag-cloud">
		{
			tags.map((tag) => {
				const count = tagCounts[tag];
				const fontSize = Math.max(1, Math.min(3, 0.8 + count * 0.5)) + 'em';
				return (
					<a href={`./${tag}/`} style={{ fontSize }} class="tag-item">
						{tag}
						<span class="count">({count})</span>
					</a>
				);
			})
		}
	</div>
</HomeLayout>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 2rem;
		border: 1px solid #eee;
		border-radius: 12px;
	}

	.tag-item {
		text-decoration: none;
		color: #333;
		transition: color 0.2s ease;
	}

	.tag-item:hover {
		color: #4f46e5; /* A nice indigo */
	}

	.count {
		font-size: 0.8rem;
		vertical-align: super;
		opacity: 0.6;
		margin-left: 0.2rem;
	}
</style>
