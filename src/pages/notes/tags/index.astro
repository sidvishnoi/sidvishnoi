---
import { getCollection } from 'astro:content';

import PageBaseLayout from '$layouts/PageBaseLayout.astro';
import PageTitleHeader from '$components/PageTitleHeader.astro';
import '$assets/styles/listing.css';

const notes = await getCollection('notes');
const allTags = notes.flatMap((e) => e.data.tags);
const tagCounts = allTags.reduce(
	(acc, tag) => {
		acc[tag] = (acc[tag] || 0) + 1;
		return acc;
	},
	Object.create(null) as Record<string, number>,
);
const tags = Object.keys(tagCounts).sort();
---

<PageBaseLayout title="All topics for Sid's Notes">
	<PageTitleHeader>
		<Fragment slot="title">
			<a href="/notes/">Notes</a> / Tags
		</Fragment>
	</PageTitleHeader>

	<div class="tag-cloud">
		{
			tags.map((tag) => {
				const count = tagCounts[tag];
				const fontSize = Math.max(1, Math.min(3, 0.8 + count * 0.5)) + 'em';
				return (
					<a href={`./${tag}/`} style={{ fontSize }} class="tag-item">
						{tag}
						<span class="count">({count})</span>
					</a>
				);
			})
		}
	</div>
</PageBaseLayout>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 2rem;
		border: 1px solid var(--color-alt);
	}

	.tag-item {
		color: var(--color);
		text-decoration: underline var(--color-link);
		text-underline-offset: 0.2em;
		transition: color 0.2s ease;
	}

	.tag-item:hover,
	.tag-item:focus {
		color: var(--color-link);
	}

	.count {
		font-size: 0.6em;
		vertical-align: super;
		opacity: 0.6;
		margin-left: 0.2rem;
	}
</style>
