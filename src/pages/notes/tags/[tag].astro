---
import { getCollection, render } from 'astro:content';
import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/NavHeader.astro';
import PageTitle from '$components/PageTitle.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

export async function getStaticPaths() {
	const allNotes = await getCollection('notes');
	const uniqueTags = [...new Set(allNotes.flatMap((post) => post.data.tags))];

	return uniqueTags.map((tag) => {
		const notes = allNotes.filter((e) => e.data.tags.includes(tag));
		return {
			params: { tag },
			props: { notes },
		};
	});
}

const { tag } = Astro.params;
const { notes: posts } = Astro.props;
---

<HomeLayout title={`#${tag} | Sid Vishnoi's notes`}>
	<Header />
	<PageTitle>
		<a href="/notes/">Notes</a> / <a href="/notes/tags/">Tags</a> /
		<span class="tag-name">#{tag}</span>
	</PageTitle>

	<div class="items">
		<ul>
			{
				posts
					.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
					.map((post) => (
						<li class="item">
							<article>
								<h3>
									<a
										href={`/notes/${post.id}/`}
										set:html={mdBackticksToHTML(post.data.heading)}
									/>
								</h3>

								<p>{post.data.description}</p>

								<div class="meta">
									<p>
										<span class="sr-only">Published </span>
										<time datetime={post.data.date.toISOString()}>
											{post.data.date.toLocaleDateString('en', {
												dateStyle: 'medium',
											})}
										</time>
									</p>
								</div>
							</article>
						</li>
					))
			}
		</ul>
	</div>
</HomeLayout>

<style>
	.tag-name {
		display: inline-block;
		color: var(--color-alt);
	}
</style>
