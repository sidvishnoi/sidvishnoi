---
import { getCollection, render } from 'astro:content';
import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/NavHeader.astro';
import PageTitle from '$components/PageTitle.astro';
import '$assets/styles/listing.css';
import { mdBackticksToHTML } from '$lib/utils.ts';

export async function getStaticPaths() {
	const allNotes = await getCollection('notes');
	const uniqueTags = [...new Set(allNotes.flatMap((post) => post.data.tags))];

	return uniqueTags.map((tag) => {
		const notes = allNotes.filter((e) => e.data.tags.includes(tag));
		return {
			params: { tag },
			props: { notes },
		};
	});
}

const { tag } = Astro.params;
const { notes: posts } = Astro.props;
---

<HomeLayout title={`#${tag} | Sid Vishnoi's notes`}>
	<Header />
	<PageTitle>
		<a href="/notes/">Notes</a> / <a href="/notes/tags/">Tags</a> /
		<span>#{tag}</span>
	</PageTitle>

	<ul>
		{
			posts.map((post) => (
				<li>
					<a
						href={`/notes/${post.id}/`}
						set:html={mdBackticksToHTML(post.data.heading)}
					/>
				</li>
			))
		}
	</ul>
</HomeLayout>

<style>
	span {
		display: inline-block;
		color: var(--color-alt);
	}
</style>
