---
import { getCollection, render } from 'astro:content';
import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/PageHeader.astro';
import Heading from '$components/Heading.astro';
import { mdBackticksToHTML } from '$lib/utils.ts';

export async function getStaticPaths() {
	const allNotes = await getCollection('notes');
	const uniqueTags = [...new Set(allNotes.flatMap((post) => post.data.tags))];

	return uniqueTags.map((tag) => {
		const notes = allNotes.filter((e) => e.data.tags.includes(tag));
		return {
			params: { tag },
			props: { notes },
		};
	});
}

const { tag } = Astro.params;
const { notes: posts } = Astro.props;
---

<HomeLayout title={`#${tag} | Sid Vishnoi's notes`}>
	<Header />
	<Heading tag="h2">
		<span>Notes with tag <span>#{tag}</span></span>
	</Heading>

	<ul>
		{
			posts.map((post) => (
				<li>
					<a
						href={`/notes/${post.id}/`}
						set:html={mdBackticksToHTML(post.data.heading)}
					/>
				</li>
			))
		}
	</ul>
</HomeLayout>

<style>
	span span {
		display: inline-block;
		color: var(--color-dark);
	}
</style>
