---
import HomeLayout from '$layouts/HomeLayout.astro';
import Header from '$components/NavHeader.astro';
import PageTitle from '$components/PageTitle.astro';
import '$assets/styles/article.css';

import { Content, frontmatter } from './_about.md';

const formatDate = (date: Date) =>
	date.toLocaleDateString('en', { dateStyle: 'medium' });
const modified = new Date(frontmatter.modified);
---

<HomeLayout
	title="About — Sid Vishnoi — Independent software engineer, full-stack developer"
	meta={{
		description: `I'm Sid, a passionate software engineer and full-stack web developer with a knack for front-end development.`,
	}}
>
	<Fragment slot="head">
		<meta property="og:type" content="profile" />
		<meta property="og:first_name" content="Sid" />
		<meta property="og:last_name" content="Vishnoi" />
		<meta property="og:username" content="sidvishnoi" />
	</Fragment>

	<Header />
	<article>
		<header>
			<PageTitle>{frontmatter.heading || 'About'}</PageTitle>
			<div class="meta">
				<p>
					Last modified{' '}
					<time datetime={modified.toISOString()}>
						{formatDate(modified)}
					</time>
				</p>
			</div>
		</header>
		<Content />
	</article>
</HomeLayout>

<style is:global>
	br {
		display: block;
		margin-top: 0.3em;
	}

	@view-transition {
		navigation: none;
	}
</style>
