---
import iconSvg from '$assets/icons/social.svg?url&no-inline';

const items: Array<{ title: string; icon: string; href: string }> = [
	{
		title: 'GitHub',
		icon: 'icon-github',
		href: 'https://github.com/sidvishnoi',
	},
	{
		title: 'Mastodon.social',
		icon: 'icon-mastodon',
		href: 'https://mastodon.social/@sidvishnoi',
	},
	{
		title: 'LinkedIn',
		icon: 'icon-linkedin',
		href: 'https://linkedin.com/in/sudhanshu-vishnoi',
	},
	{
		title: 'StackOverflow',
		icon: 'icon-stackoverflow',
		href: 'https://stackoverflow.com/users/3367669/sid-vishnoi',
	},
];
---

<nav class="social">
	<ul>
		{
			items.map((item) => (
				<li>
					<a rel="me" title={item.title} href={item.href}>
						<span class="visually-hidden">{item.title}</span>
						<svg width="18" height="18" aria-hidden="true">
							<use xlink:href={`${iconSvg}#${item.icon}`} />
						</svg>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.social ul {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social a {
		display: flex;
		padding: 0.25em;
	}

	.social a svg {
		width: 18px;
		height: 18px;
		fill: var(--color-alt);
	}

	.social a:hover svg,
	.social a:focus svg {
		fill: var(--color);
	}
</style>
